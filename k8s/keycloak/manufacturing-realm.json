{
  "realm": "manufacturing",
  "displayName": "Vehicle Manufacturing",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "VIEWER",
        "description": "Read-only access"
      },
      {
        "name": "PLANNER",
        "description": "Plans production orders"
      },
      {
        "name": "SUPERVISOR",
        "description": "Runs the line: status changes and progress"
      },
      {
        "name": "ADMIN",
        "description": "Full access incl. plants and vehicle models"
      }
    ]
  },
  "clients": [
    {
      "clientId": "manufacturing-cli",
      "name": "Postman / CLI / Swagger (development only)",
      "description": "Public client with password grant for local testing. Do not use in production.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "audience: vehicle-manufacturing-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "vehicle-manufacturing-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VIEWER"
      ]
    },
    {
      "username": "planner",
      "enabled": true,
      "email": "planner@example.com",
      "emailVerified": true,
      "firstName": "Paul",
      "lastName": "Planner",
      "credentials": [
        {
          "type": "password",
          "value": "planner123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PLANNER"
      ]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "email": "supervisor@example.com",
      "emailVerified": true,
      "firstName": "Sara",
      "lastName": "Supervisor",
      "credentials": [
        {
          "type": "password",
          "value": "supervisor123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPERVISOR"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Adam",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    }
  ]
}